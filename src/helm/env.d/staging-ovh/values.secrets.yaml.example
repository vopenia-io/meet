# Copy to values.secrets.yaml (not versioned). Never in a commit, a report or a log.
djangoSecretKey: set-me
# The same key as the SFU nodes' keys.yaml (terraform/ovh/secrets.sh): Meet does not change it at
# the switch between LiveKit and Ilimo.
livekit:
  keys:
    set-me-key-name: set-me-secret
oidc:
  clientId: meet
  clientSecret: set-me
postgresql:
  meetUser: meet
  meetPassword: set-me
# secrets/redis-meet-password and secrets/livekit-redis-password: the same files the platform's
# Secrets and the LiveKit nodes read (platform/staging-ovh/k8s-secrets.sh in ilimo-deploy).
redis:
  password: set-me
  livekitPassword: set-me
# The recordings' S3 user of staging/keep (secrets/keep-recordings-s3-*): it reaches the recordings'
# container only, never the backups' (one user per container, bsenard, 07/11/2026).
s3:
  accessKey: set-me
  secretKey: set-me
