# Authentik, the identity provider of the platform in place of Keycloak (decision of 06/11), on
# the managed PostgreSQL of staging/base (its database `keycloak` there becomes `authentik`).
# Chart 2026.8.5: no Redis (Authentik no longer uses one).
#
# Its connections are bounded by its processes and threads: Authentik has no pool size.
#   server: workers × threads = 2 × 4 = 8, worker: processes × threads = 1 × 2 = 2, plus the
#   worker's LISTEN connection: about 11, under the 20 that Keycloak's pool was bounded to in
#   the db1-4 budget (about 100 connections, about 80 used).
# The secret key, the database password and Meet's client secret come from the Secret
# authentik-secrets (AUTHENTIK_SECRET_KEY, AUTHENTIK_POSTGRESQL__PASSWORD,
# AUTHENTIK_MEET_CLIENT_SECRET), made out of band like the database users (db-users.sh): never in
# these values. Meet's signing key is the Secret authentik-meet-signing (tls.crt, tls.key).
#
# Authentik's configuration for Meet is the blueprint blueprints/meet.yaml (P0-120 step 0b),
# versioned, in a ConfigMap the worker applies: a new instance gets it without a dump.
{{- $v := .Values }}
authentik:
  log_level: info
  error_reporting:
    enabled: false
  postgresql:
    host: {{ $v.postgresql.host }}
    port: {{ $v.postgresql.port }}
    name: authentik
    user: authentik

global:
  env:
    - name: AUTHENTIK_POSTGRESQL__SSLMODE
      value: {{ $v.postgresql.sslmode | default "require" }}
    # Persistent connections, bounded by the threads below.
    - name: AUTHENTIK_POSTGRESQL__CONN_MAX_AGE
      value: "60"
    - name: AUTHENTIK_POSTGRESQL__CONN_HEALTH_CHECKS
      value: "true"
    - name: AUTHENTIK_WEB__WORKERS
      value: "2"
    - name: AUTHENTIK_WEB__THREADS
      value: "4"
    - name: AUTHENTIK_WORKER__PROCESSES
      value: "1"
    - name: AUTHENTIK_WORKER__THREADS
      value: "2"
    # Read by the blueprint (!Env MEET_HOST): Meet's redirect URIs.
    - name: MEET_HOST
      value: {{ $v.hosts.meet }}
  envFrom:
    - secretRef:
        name: authentik-secrets

server:
  replicas: 1
  ingress:
    enabled: true
    ingressClassName: {{ $v.ingressClass }}
    annotations:
      cert-manager.io/cluster-issuer: {{ $v.clusterIssuer }}
      traefik.ingress.kubernetes.io/router.entrypoints: websecure
      traefik.ingress.kubernetes.io/router.tls: "true"
    hosts:
      - {{ $v.hosts.id }}
    tls:
      - secretName: authentik-tls
        hosts:
          - {{ $v.hosts.id }}

worker:
  replicas: 1
  # Meet's signing key, discovered by the worker as the key pair "meet-signing" (the folder's
  # name; the Secret's ..data links are hidden files, which the discovery skips).
  volumes:
    - name: meet-signing
      secret:
        secretName: authentik-meet-signing
  volumeMounts:
    - name: meet-signing
      mountPath: /certs/meet-signing
      readOnly: true

blueprints:
  configMaps:
    - authentik-blueprint-meet
    # ConfigMap separe : on peut retirer les comptes de dev sans toucher au blueprint de Meet.
    - authentik-blueprint-dev-users

additionalObjects:
  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: authentik-blueprint-meet
    data:
      meet.yaml: |
{{/* readFile resout depuis le repertoire du fichier de values, pas depuis la racine du
     helmfile : le chemin complet donnait env.d/staging-ovh/env.d/staging-ovh/blueprints/...
     Trouve au premier rendu de staging-ovh, le 08/11/2026 18:16Z -- readFile n est utilise
     dans aucun autre environnement, ce code n avait donc jamais ete exerce. */}}
{{ readFile "blueprints/meet.yaml" | indent 8 }}

  # Les comptes de dev (bsenard, 08/11/2026) : rejoues a chaque demarrage du worker, donc
  # presents meme sur une base Authentik vierge. Leur mot de passe n est PAS ici : le
  # serializer d Authentik n expose pas ce champ, dev-users-password.sh s en charge.
  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: authentik-blueprint-dev-users
    data:
      dev-users.yaml: |
{{ readFile "blueprints/dev-users.yaml" | indent 8 }}
