#!KAMAILIO
##############################################################################
# Minimal Kamailio Configuration for Dev Environment
# - IPPI trunk: DIDs +33 5 35 00 59 42, +33 1 77 45 54 39
# - Registrar: Video conference SIP devices (with BFCP support)
# - Route to: LiveKit-SIP at 192.168.0.10:5080
##############################################################################

#### Core Settings
log_stderror=yes
debug=2
log_facility=LOG_LOCAL0
fork=yes
children=4

#### TCP Settings (required for BFCP support - must be before modules)
disable_tcp=no
tcp_accept_no_cl=yes
tcp_connection_lifetime=3605
tcp_max_connections=2048

#### Network
listen=udp:192.168.0.10:5060 advertise 192.168.0.10:5060
listen=tcp:192.168.0.10:5060 advertise 192.168.0.10:5060

#### Modules
loadmodule "tm.so"
loadmodule "tmx.so"
loadmodule "sl.so"
loadmodule "rr.so"
loadmodule "pv.so"
loadmodule "maxfwd.so"
loadmodule "textops.so"
loadmodule "siputils.so"
loadmodule "xlog.so"
loadmodule "sanity.so"
loadmodule "usrloc.so"
loadmodule "registrar.so"
loadmodule "db_sqlite.so"
loadmodule "uac.so"


#### Module Parameters
modparam("tm", "fr_timer", 30000)
modparam("tm", "fr_inv_timer", 120000)
modparam("rr", "enable_full_lr", 1)
modparam("usrloc", "db_mode", 0)
modparam("registrar", "max_contacts", 10)

# UAC Registration Parameters
modparam("uac", "reg_db_url", "sqlite:///etc/kamailio/db/kamailio.db")
modparam("uac", "reg_db_table", "uacreg")
modparam("uac", "reg_contact_addr", "192.168.0.10:5060")
modparam("uac", "reg_timer_interval", 90)
modparam("uac", "reg_retry_interval", 30)
modparam("uac", "reg_active", 1)
modparam("uac", "reg_keep_callid", 1)

#### Main Request Route
request_route {
    xlog("L_INFO", ">>> $rm $ru (From: $fu, SrcIP: $si:$sp, Transport: $proto)\n");

    # Sanity checks
    if (!mf_process_maxfwd_header("70")) {
        sl_send_reply("483", "Too Many Hops");
        exit;
    }

    if (!sanity_check("1511", "7")) {
        xlog("L_ERR", "Malformed message\n");
        exit;
    }

    # IPPI trunk: Check source IP (update with actual IPPI IPs)
    if ($si =~ "^91\.194\." || $si =~ "^185\.47\." || $si =~ "^194\.169\.214\.") {
        xlog("L_INFO", "IPPI trunk call\n");
        route(FROM_IPPI);
        exit;
    }

    # CANCEL
    if (is_method("CANCEL")) {
        if (t_check_trans()) {
            t_relay();
        } else {
            sl_send_reply("481", "Transaction Does Not Exist");
        }
        exit;
    }

    # In-dialog requests
    if (has_totag()) {
        route(WITHINDLG);
        exit;
    }

    # Record-Route for dialog-creating requests
    if (is_method("INVITE|SUBSCRIBE")) {
        record_route();
    }

    # REGISTER
    if (is_method("REGISTER")) {
        route(REGISTRAR);
        exit;
    }

    # OPTIONS keepalive
    if (is_method("OPTIONS")) {
        sl_send_reply("200", "OK");
        exit;
    }

    # INVITE from registered devices
    if (is_method("INVITE")) {
        route(INVITE);
        exit;
    }

    sl_send_reply("405", "Method Not Allowed");
}

#### Route: WITHINDLG - In-dialog requests
route[WITHINDLG] {
    xlog("L_INFO", "=== WITHINDLG: $rm from $si to $ru ===\n");
    xlog("L_INFO", "  From: $fu\n");
    xlog("L_INFO", "  To: $tu\n");
    xlog("L_INFO", "  Call-ID: $ci\n");
    xlog("L_INFO", "  CSeq: $cs $rm\n");
    xlog("L_INFO", "  Route headers: $hdr(Route)\n");
    xlog("L_INFO", "  Request-URI: $ru\n");

    if (loose_route()) {
        xlog("L_INFO", "  ✓ loose_route() succeeded\n");
        xlog("L_INFO", "  Request-URI after loose_route: $ru\n");
        xlog("L_INFO", "  Route headers after loose_route: $hdr(Route)\n");
        xlog("L_INFO", "  Destination: $du\n");

        if (is_method("ACK")) {
            xlog("L_INFO", "  Forwarding ACK to $ru\n");
            t_relay();
            exit;
        }

        if (is_method("BYE")) {
            xlog("L_INFO", "  BYE - call termination to $ru\n");
        }

        if (is_method("INVITE")) {
            xlog("L_INFO", "  🔄 re-INVITE - media renegotiation\n");
            xlog("L_INFO", "  Will forward to Request-URI: $ru\n");
            xlog("L_INFO", "  Source IP: $si:$sp\n");
            xlog("L_INFO", "  Content-Length: $hdr(Content-Length)\n");
        }

        if (is_method("UPDATE")) {
            xlog("L_INFO", "  UPDATE - session refresh\n");
        }

        if (is_method("INFO")) {
            xlog("L_INFO", "  INFO (Content-Type: $hdr(Content-Type))\n");
            # Check if LiveKit-SIP supports INFO, if not absorb it here
            if ($hdr(Content-Type) =~ "application/media_control") {
                xlog("L_INFO", "  Polycom FECC (camera control) - absorbing INFO message\n");
                sl_send_reply("200", "OK");
                exit;
            }
        }

        if (is_method("NOTIFY")) {
            xlog("L_INFO", "  NOTIFY (Event: $hdr(Event))\n");
        }

        if (is_method("REFER")) {
            xlog("L_INFO", "  REFER (Refer-To: $hdr(Refer-To))\n");
        }

        xlog("L_INFO", "  📤 Calling t_relay() to forward $rm to $ru\n");
        if (!t_relay()) {
            xlog("L_ERR", "  ❌ t_relay() FAILED for $rm\n");
            sl_reply_error();
        } else {
            xlog("L_INFO", "  ✅ t_relay() succeeded for $rm\n");
        }
        exit;
    } else {
        xlog("L_WARN", "  ❌ loose_route() FAILED - no Route headers or routing failed\n");
    }

    # ACK without Route - absorb
    if (is_method("ACK")) {
        exit;
    }

    # BYE/NOTIFY without Route - try direct relay
    if (is_method("BYE|NOTIFY")) {
        t_relay();
        exit;
    }

    sl_send_reply("481", "Call/Transaction Does Not Exist");
}

#### Route: REGISTRAR - SIP device registration
route[REGISTRAR] {
    xlog("L_INFO", "REGISTER from $fu (Contact: $ct)\n");

    # Save location (no authentication for dev)
    if (!save("location")) {
        sl_send_reply("500", "Error saving location");
        exit;
    }

    xlog("L_INFO", "Registered: $fu\n");
    exit;
}

#### Route: FROM_IPPI - IPPI trunk calls
route[FROM_IPPI] {
    xlog("L_INFO", "IPPI: Caller=$fU Called=$rU\n");

    # Only accept our DIDs or ippi-trunk
    # DID 1: +33535005942, DID 2: +33177455439
    if ($rU != "33535005942" && $rU != "+33535005942" && $rU != "0535005942" &&
        $rU != "33177455439" && $rU != "+33177455439" && $rU != "0177455439" &&
        $rU != "ippi-trunk") {
        xlog("L_WARN", "Unknown DID: $rU\n");
        sl_send_reply("404", "Number Not Found");
        exit;
    }

    # Log BFCP if present (for video conferencing)
    if (has_body("application/sdp")) {
        if (search_body("m=application")) {
            xlog("L_INFO", "BFCP media line detected\n");
        }
        if (search_body("m=video")) {
            xlog("L_INFO", "Video call detected\n");
        }
    }

    # In-dialog requests
    if (has_totag()) {
        route(WITHINDLG);
        exit;
    }

    # Initial INVITE
    if (is_method("INVITE")) {
        record_route();
        route(TO_LIVEKIT_SIP);
        exit;
    }

    # OPTIONS keepalive
    if (is_method("OPTIONS")) {
        sl_send_reply("200", "OK");
        exit;
    }

    sl_send_reply("405", "Method Not Allowed");
}

#### Route: INVITE - From registered devices
route[INVITE] {
    xlog("L_INFO", "INVITE to $rU\n");

    # Log BFCP/media information if present
    if (has_body("application/sdp")) {
        # Log the full SDP for debugging
        xlog("L_INFO", "=== SDP BODY START ===\n$rb\n=== SDP BODY END ===\n");

        if (search_body("m=application.*BFCP")) {
            xlog("L_INFO", "*** BFCP DETECTED in INVITE from registered device ***\n");
        }
        if (search_body("m=application.*TCP/BFCP")) {
            xlog("L_INFO", "*** BFCP over TCP detected ***\n");
        }
        if (search_body("m=application")) {
            xlog("L_INFO", "m=application line found (check if BFCP or H.224)\n");
        }
        if (search_body("m=video")) {
            xlog("L_INFO", "Video call from registered device\n");
        }
    }

    # PIN detection and routing logic for registered devices
    # Case 1: PIN detected (numeric, 1-10 digits) - Route to LiveKit-SIP with X-PIN header
    if ($rU =~ "^[0-9]{1,10}$") {
        xlog("L_INFO", "PIN detected: $rU - routing to LiveKit-SIP\n");

        # Store PIN in variable
        $var(pin) = $rU;

        # Add X-PIN header
        append_hf("X-PIN: $var(pin)\r\n");

        # Rewrite Request-URI to gw+@livekit-sip
        $ru = "sip:gw+@192.168.0.10:5080;transport=tcp";

        xlog("L_INFO", "Routing PIN $var(pin) to LiveKit-SIP: $ru\n");

        if (!t_relay()) {
            sl_reply_error();
        }
        exit;
    }

    # Case 2: Valid phone number detected - Outbound call (NOT to LiveKit-SIP)
    if ($rU =~ "^\+[0-9]{1,15}$" || $rU =~ "^0[0-9]{9,}$" || $rU =~ "^[0-9]{11,}$") {
        xlog("L_INFO", "Valid phone number detected: $rU - treating as outbound call\n");

        # Check if destination is registered
        if (lookup("location")) {
            xlog("L_INFO", "Calling registered device: $ru\n");
            t_relay();
            exit;
        }

        # For true outbound calls, you would add your outbound routing logic here
        # For now, reject with appropriate message
        xlog("L_WARN", "Outbound call to $rU - no outbound route configured\n");
        sl_send_reply("404", "Not Found");
        exit;
    }

    # Case 3: Invalid format
    xlog("L_WARN", "Invalid destination format: $rU\n");
    sl_send_reply("484", "Address Incomplete");
    exit;
}

#### Route: TO_LIVEKIT_SIP - Forward to LiveKit-SIP
route[TO_LIVEKIT_SIP] {
    # LiveKit-SIP destination - force TCP transport
    # Rewrite Request-URI to include transport parameter
    $ru = "sip:" + $rU + "@192.168.0.10:5080;transport=tcp";

    xlog("L_INFO", "Routing to LiveKit-SIP via TCP: $ru\n");

    if (!t_relay()) {
        sl_reply_error();
    }
}

#### Reply Route
onreply_route {
    xlog("L_INFO", "<<< Reply: $rs $rr for $rm (To: $tu, From: $fu)\n");
    if (is_method("INVITE")) {
        xlog("L_INFO", "  INVITE response: $rs $rr\n");
        xlog("L_INFO", "  Call-ID: $ci\n");
        xlog("L_INFO", "  CSeq: $cs\n");
    }
}
